# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas (free M0 cluster works). The worker (your PC) and the API (your server)
# must use the SAME database, so use a cloud MongoDB, not a local one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=igsync

# Instagram profile to track (username or full profile URL)
IG_PROFILE=your_username

# Optional: route the Instagram request through a proxy
# IG_PROXY=http://user:pass@host:port

# API only: secret the WordPress plugin sends in the X-API-Key header
API_KEY=change-me-to-a-long-random-string
ADDR=:8080
